<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirportFlightManagement.ViewModels"
             x:Class="AirportFlightManagement.Views.AirportsView"
             x:DataType="vm:AirportsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="24" Background="{DynamicResource WindowBackground}">

            <!-- Header -->
            <Grid ColumnDefinitions="*,auto" ColumnSpacing="20">
                <TextBlock Text="Airports" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Add Airport" Classes="primary" Click="OnAddAirportClick"/>
            </Grid>

            <!-- Summary Stats -->
            <Border Background="{DynamicResource SurfaceBackground}" Padding="15" CornerRadius="4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel Spacing="10" Orientation="Horizontal">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Total Airports" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalAirports}" Foreground="{DynamicResource MetallicGoldBrush}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Spacing="5" Margin="30,0,0,0">
                        <TextBlock Text="Active" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        <TextBlock Text="{Binding ActiveAirports}" Foreground="{DynamicResource SuccessAltBrush}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Search Bar -->
            <TextBox Text="{Binding SearchText}" Watermark="Search by name, code or country..." Width="300" HorizontalAlignment="Left"/>

            <!-- Airports List -->
            <TextBlock Text="Airports:" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>

            <ItemsControl ItemsSource="{Binding PagedAirports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,8">
                            <Grid ColumnDefinitions="*,auto" ColumnSpacing="15">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <Border Background="{DynamicResource BorderColor}" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="15">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="City" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding City}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Country" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding Country}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Status" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding IsActive}" Foreground="{DynamicResource SuccessAltBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Edit" Classes="primary" VerticalAlignment="Center" Padding="15,8" Click="OnEditClick"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Width="100" HorizontalContentAlignment="Center"/>
                <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" Width="100" HorizontalContentAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
