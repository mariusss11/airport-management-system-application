<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirportFlightManagement.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="840"
             x:Class="AirportFlightManagement.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             Padding="24">

    <StackPanel Spacing="24">
        <TextBlock Text="Search Flights" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>

        <!-- Search Filters -->
        <Border Classes="card" Padding="20">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="auto,auto,auto" ColumnSpacing="16" RowSpacing="16">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                        <Label Content="Destination" FontWeight="Bold"/>
                        <TextBox Text="{Binding Destination}" Watermark="e.g. Paris"/>
                    </StackPanel>

                    <!-- <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8"> -->
                    <!--     <Label Content="Day of Week" FontWeight="Bold"/> -->
                    <!--     <ComboBox SelectedIndex="{Binding SelectedDay}"> -->
                    <!--         <ComboBoxItem>All Days</ComboBoxItem> -->
                    <!--         <ComboBoxItem>Monday</ComboBoxItem> -->
                    <!--         <ComboBoxItem>Tuesday</ComboBoxItem> -->
                    <!--         <ComboBoxItem>Wednesday</ComboBoxItem> -->
                    <!--         <ComboBoxItem>Thursday</ComboBoxItem> -->
                    <!--         <ComboBoxItem>Friday</ComboBoxItem> -->
                    <!--         <ComboBoxItem>Saturday</ComboBoxItem> -->
                    <!--         <ComboBoxItem>Sunday</ComboBoxItem> -->
                    <!--     </ComboBox> -->
                    <!-- </StackPanel> -->

                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="8">
                        <Label Content="Min Available Seats" FontWeight="Bold"/>
                        <NumericUpDown Value="{Binding MinSeats}" Minimum="0" Increment="1" Maximum="500"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                        <Label Content="From Time" FontWeight="Bold"/>
                        <TextBox Text="{Binding FromTime}" Watermark="HH:mm"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                        <Label Content="To Time" FontWeight="Bold"/>
                        <TextBox Text="{Binding ToTime}" Watermark="HH:mm"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="8">
                        <Label Content="Status" FontWeight="Bold"/>
                        <ComboBox SelectedItem="{Binding SelectedStatus}">
                            <ComboBoxItem>All</ComboBoxItem>
                            <ComboBoxItem>On Time</ComboBoxItem>
                            <ComboBoxItem>Delayed</ComboBoxItem>
                            <ComboBoxItem>Canceled</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Search" Classes="primary" HorizontalContentAlignment="Center" Command="{Binding SearchCommand}" Width="120"/>
                    <Button Content="Reset" Classes="secondary" HorizontalContentAlignment="Center" Command="{Binding ResetCommand}" Width="120"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Classes="card" IsVisible="{Binding HasSearched}">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding SearchResults.Count, StringFormat='Found {0} flights'}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>

                <DataGrid ItemsSource="{Binding SearchResults}" IsReadOnly="True" ColumnHeaderHeight="40" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding FlightCode}" Width="80"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="120"/>
                        <DataGridTextColumn Header="Day" Binding="{Binding DayName}" Width="100"/>
                        <DataGridTextColumn Header="Departure" Binding="{Binding DepartureTime, StringFormat='HH:mm'}" Width="100"/>
                        <DataGridTextColumn Header="Available" Binding="{Binding AvailableSeats}" Width="80"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding TicketPrice, StringFormat='€{0:F2}'}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>
