<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirportFlightManagement.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="840"
             x:Class="AirportFlightManagement.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Padding="24">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">
            <!-- Header -->
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />

            <!-- Stats Row -->
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="auto" ColumnSpacing="16" RowSpacing="16">
                <!-- Total Flights Card -->
                <Border Grid.Column="0" Classes="stat-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Active Flights" FontSize="14" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding TotalFlights}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource MetallicGoldBrush}" />
                    </StackPanel>
                </Border>

                <!-- Available Seats Card -->
                <Border Grid.Column="1" Classes="stat-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Available Seats" FontSize="14" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding AvailableSeats}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource MetallicGoldBrush}" />
                    </StackPanel>
                </Border>

                <!-- Planes At Airport Card -->
                <Border Grid.Column="2" Classes="stat-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Planes Today" FontSize="14" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding PlanesAtAirport}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource MetallicGoldBrush}" />
                    </StackPanel>
                </Border>

                <!-- Canceled Flights Card -->
                <Border Grid.Column="3" Classes="stat-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Canceled" FontSize="14" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding CanceledFlights}" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource MetallicGoldBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Longest Flight Highlight -->
            <Border CornerRadius="8" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#DC143C" Offset="0" />
                        <GradientStop Color="#8B0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,auto">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Longest Flight Duration" FontSize="14" LetterSpacing="0.3"
                                   Foreground="#FFFFFF" FontWeight="Bold" />
                        <TextBlock Text="{Binding LongestFlight.FlightCode}" Foreground="#E0E0E0" FontSize="12"
                                   Opacity="0.9" />
                        <TextBlock Text="{Binding LongestFlight.DepartureAirport.Name, StringFormat='From {0}'}" FontSize="18"
                                   Foreground="#FFFFFF" FontWeight="Bold" />
                        <TextBlock Text="{Binding LongestFlight.Destination, StringFormat='To {0}'}" FontSize="18"
                                   Foreground="#FFFFFF" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding LongestFlight.DurationFormatted}" FontSize="28" FontWeight="Bold"
                                   Foreground="#FFFFFF" TextAlignment="Right" />
                        <TextBlock Text="{Binding AveragePrice, StringFormat=F2}" FontSize="12" Foreground="#E0E0E0"
                                   TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Today's Flights Table -->
            <TextBlock Text="Today's Flights" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" />
            <ItemsControl ItemsSource="{Binding PagedFlights}">
                <ItemsControl.ItemTemplate>

                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBackground}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4"
                                Padding="15" Margin="0,8">
                            <Grid ColumnDefinitions="*, auto" ColumnSpacing="15">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Flight}"></TextBlock>
                                    <TextBlock Text="{Binding FlightCode}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="20">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Departure" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding DepartureAirport.Name}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Destination" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding Destination}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Date" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding DepartureDate, StringFormat='dd MMM yyyy'}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Departure" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding DepartureTime, StringFormat='HH:mm'}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Arrival" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding ArrivalTime, StringFormat='HH:mm'}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Price" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding TicketPrice, StringFormat='${0}'}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Duration" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding DurationFormatted}"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Width="100" HorizontalContentAlignment="Center"/>
                <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" Width="100" HorizontalContentAlignment="Center"/>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>

</UserControl>