<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirportFlightManagement.ViewModels"
             x:Class="AirportFlightManagement.Views.FlightsView"
             x:DataType="vm:FlightsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="24" Background="{DynamicResource WindowBackground}">
            
            <!-- Header -->
            <Grid ColumnDefinitions="*,auto" ColumnSpacing="20">
                <TextBlock Text="Flights" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="New Flight" Classes="primary" Command="{Binding NewFlightCommand}" Click="NewFlightButton_Click"/>
            </Grid>
            
            <!-- Summary Stats -->
            <Border Background="{DynamicResource SurfaceBackground}" Padding="15" CornerRadius="4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel Spacing="10" Orientation="Horizontal">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Total Flights" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        <TextBlock Text="{Binding Flights.Count}" Foreground="{DynamicResource MetallicGoldBrush}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Search and Filter -->
            <Grid ColumnDefinitions="*,auto" ColumnSpacing="10">
                <TextBox Text="{Binding SearchText}" Watermark="Search by flight code or destination..." Grid.Column="0"/>
                <!-- <TextBlock Text="{Binding Flights.Count, StringFormat='Showing {0} results'}" Foreground="#8B8B8B" Grid.Column="1" VerticalAlignment="Center" FontSize="12"/> -->
            </Grid>
            
            <!-- Flights List -->
            <TextBlock Text="Available Flights:" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
            
            <ItemsControl ItemsSource="{Binding PagedFlights}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,8">
                            <Grid ColumnDefinitions="*,auto" ColumnSpacing="15">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding FlightCode}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="20">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Departure" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding DepartureAirport.Name}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Destination" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding Destination}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Date" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding DepartureDate, StringFormat='dd MMM yyyy'}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Departure" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding DepartureTime, StringFormat='HH:mm'}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Arrival" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding ArrivalTime, StringFormat='HH:mm'}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Price" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding TicketPrice, StringFormat='${0}'}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Duration" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding DurationFormatted}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        </StackPanel>
                                        <!-- <StackPanel Spacing="2"> -->
                                            <!-- <TextBlock Text="Status" Foreground="{DynamicResource TextMuted}" FontSize="11"/> -->
                                            <!-- <TextBlock Text="{Binding Status}" Foreground="#4CAF50" FontSize="12"/> -->
                                        <!-- </StackPanel> -->
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Edit" Classes="primary" VerticalAlignment="Center" Padding="15,8" Click="EditButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Width="100" HorizontalContentAlignment="Center"/>
                <TextBlock Text="{Binding CurrentPage}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" Width="100" HorizontalContentAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
