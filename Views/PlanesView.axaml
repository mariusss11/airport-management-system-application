<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AirportFlightManagement.ViewModels"
             x:Class="AirportFlightManagement.Views.PlanesView"
             x:DataType="vm:PlanesViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="24" Background="#0A0E27">
            
            <!-- Header -->
            <Grid ColumnDefinitions="*,auto" ColumnSpacing="20">
                <TextBlock Text="Planes" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Add Plane" Classes="primary" Command="{Binding NewPlaneCommand}"/>
            </Grid>
            
            <!-- Summary Stats -->
            <Border Background="#1A1F3A" Padding="15" CornerRadius="4" BorderBrush="#2A2F4A" BorderThickness="1">
                <StackPanel Spacing="10" Orientation="Horizontal">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Total Planes" Foreground="#8B8B8B" FontSize="12"/>
                        <TextBlock Text="{Binding TotalPlanes}" Foreground="#D4AF37" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Spacing="5" Margin="30,0,0,0">
                        <TextBlock Text="At Airport" Foreground="#8B8B8B" FontSize="12"/>
                        <TextBlock Text="{Binding PlanesAtAirport}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Spacing="5" Margin="30,0,0,0">
                        <TextBlock Text="Away" Foreground="#8B8B8B" FontSize="12"/>
                        <TextBlock Text="{Binding PlanesAway}" Foreground="#FF9800" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Search Bar -->
            <TextBox Text="{Binding SearchText}" Watermark="Search by plane code or model..." Width="300" HorizontalAlignment="Left"/>
            
            <!-- Planes List -->
            <TextBlock Text="Available Planes:" Foreground="#FFF" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
            
            <ItemsControl ItemsSource="{Binding PagedPlanes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1F3A" BorderBrush="#2A2F4A" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,8">
                            <Grid ColumnDefinitions="*,auto" ColumnSpacing="15">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding RegistrationNumber}" FontSize="16" FontWeight="Bold" Foreground="#DC143C"/>
                                    <StackPanel Orientation="Horizontal" Spacing="15">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Model" Foreground="#8B8B8B" FontSize="11"/>
                                            <TextBlock Text="{Binding Model}" Foreground="#E0E0E0" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Status" Foreground="#8B8B8B" FontSize="11"/>
                                            <TextBlock Text="{Binding AtAirport}" Foreground="#4CAF50" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Edit" Classes="primary" VerticalAlignment="Center" Padding="15,8"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"  Margin="0,20,0,0">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Width="100"  HorizontalContentAlignment="Center"/>
                <TextBlock Text="{Binding CurrentPage}" Foreground="#FFF" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" Width="100" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
