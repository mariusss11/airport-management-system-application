<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AirportFlightManagement.App"
             xmlns:local="using:AirportFlightManagement"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AirportFlightManagement/Styles/DarkTheme.axaml" />
    </Application.Styles>
</Application>