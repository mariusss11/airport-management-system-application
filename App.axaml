<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AirportFlightManagement.App"
             xmlns:local="using:AirportFlightManagement"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AirportFlightManagement/Styles/ThemeColors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AirportFlightManagement/Styles/DarkTheme.axaml" />
        <StyleInclude Source="avares://AirportFlightManagement/Styles/CalendarTheme.axaml" />
    </Application.Styles>
</Application>
